# ==============================================================================
# KONFIGURASI SUPABASE (FRONTEND VITE)
# ==============================================================================
# Salin file ini menjadi '.env' di folder root proyek, lalu isi dengan
# URL Project dan Anon Key yang didapat dari Supabase Dashboard:
# Project Settings -> API
#
# PERINGATAN KEAMANAN:
# - HANYA gunakan 'anon public' key di frontend.
# - JANGAN PERNAH memasukkan 'service_role key' (secret key) ke frontend!
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
